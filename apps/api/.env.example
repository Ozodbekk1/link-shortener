NODE_ENV=production
PORT=8080

# PostgreSQL Neon Database URL (connection pooler recommended for serverless)
DATABASE_URL=postgresql://user:password@ep-pooler.region.aws.neon.tech/neondb?sslmode=require

# JWT Secrets
JWT_SECRET=your-min-32-character-jwt-secret-key-here
JWT_ACCESS_SECRET=your-min-32-character-access-secret-key-here
JWT_REFRESH_SECRET=your-min-32-character-refresh-secret-key-here
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Allowed Web Origins (comma-separated)
WEB_ORIGIN=https://uurl.uz,https://www.uurl.uz,http://localhost:3000

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Telegram Auth
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TG_AUTH_BYPASS_SECRET=your-telegram-bypass-secret

# Google OAuth
GOOGLE_AUTH_BYPASS_SECRET=your-google-bypass-secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://api.uurl.uz/api/v1/google/auth/callback

