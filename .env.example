NODE_ENV=development
PORT=8080
WEB_ORIGIN=http://localhost:3000,http://uurl.uz,https://uurl.uz

DATABASE_URL=postgresql:db-from-neondb

REDIS_URL=redis://redis:6379

JWT_SECRET=your-jwt-secret-min-32-chars-long!!!!!!!!!
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-long!!!!!
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long!!!!
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TG_AUTH_BYPASS_SECRET=your-tg-bypass-secret

GOOGLE_AUTH_BYPASS_SECRET=your-google-bypass-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
